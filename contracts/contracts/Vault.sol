pragma solidity ^0.8.28;
import {AssetRegistry, IAggregatorV3} from "./AssetRegistry.sol";
interface IERC20 { function balanceOf(address) external view returns(uint256); function transfer(address,uint256) external returns(bool); function transferFrom(address,address,uint256) external returns(bool); function approve(address,uint256) external returns(bool); }
interface ISwapAdapter { function swap(address,address,uint256,uint256,bytes calldata) external returns(uint256); }
contract Vault {
 struct VaultConfig {uint16 maxAllocationPerAssetBps;uint16 maxSlippageBps;uint64 minRebalanceInterval;}
 struct VaultInit {address baseAsset;address executor;VaultConfig config;address[] allowedAssets;}
 struct Allocation {address asset;uint16 targetBps;} struct Trade {address tokenIn;address tokenOut;uint256 amountIn;uint256 minAmountOut;bytes routeData;}
 uint16 public constant BPS=10_000; uint16 public constant MAX_SLIPPAGE_BPS=1_000; uint256 public constant MAX_ALLOWED_ASSETS=16;
 address public owner; address public pendingOwner; AssetRegistry public assetRegistry; ISwapAdapter public swapAdapter; address public baseAsset; address public executor; VaultConfig public config; bool public automationPaused; uint64 public lastRebalance; bool private initialized; uint256 private locked;
 mapping(address=>bool) private allowed; address[] private assets; mapping(address=>uint256) private index;
 event Deposited(address indexed owner,address indexed asset,uint256 amount); event Withdrawn(address indexed owner,address indexed asset,uint256 amount); event AllowedAssetAdded(address indexed asset); event AllowedAssetRemoved(address indexed asset); event ConfigUpdated(uint16,uint16,uint64); event ExecutorUpdated(address indexed oldExecutor,address indexed newExecutor); event AutomationPaused(address indexed owner); event AutomationUnpaused(address indexed owner); event TradeExecuted(address indexed tokenIn,address indexed tokenOut,uint256 amountIn,uint256 amountOut); event Rebalanced(address indexed executor,bytes32 indexed targetHash,uint256 tradeCount,uint64 timestamp);
 error Unauthorized(); error AlreadyInitialized(); error InvalidInitializationCaller(); error ZeroAddress(); error ZeroAmount(); error VaultPaused(); error RebalanceTooSoon(uint64); error EmptyRebalance(); error UnsupportedAsset(address); error InactiveAsset(address); error AssetNotAllowed(address); error AssetAlreadyAllowed(address); error BaseAssetRemovalForbidden(); error AssetBalanceNotZero(address,uint256); error TooManyAllowedAssets(); error InvalidConfig(); error InvalidAllocation(); error AllocationTooHigh(address,uint256,uint256); error InvalidTrade(); error OracleUnavailable(address); error OracleSlippageExceeded(uint256,uint256); error InsufficientOutput(uint256,uint256); error TransferFailed();
 modifier onlyOwner(){if(msg.sender!=owner) revert Unauthorized(); _;} modifier onlyExecutor(){if(msg.sender!=executor||executor==address(0)) revert Unauthorized(); _;} modifier nonReentrant(){if(locked==1) revert Unauthorized();locked=1;_;locked=0;}
 function initialize(address initialOwner,AssetRegistry registry,ISwapAdapter adapter,VaultInit calldata init,address factory) external {if(initialized) revert AlreadyInitialized();if(msg.sender!=factory) revert InvalidInitializationCaller();if(initialOwner==address(0)||address(registry)==address(0)||address(adapter)==address(0)) revert ZeroAddress(); initialized=true;owner=initialOwner;assetRegistry=registry;swapAdapter=adapter;baseAsset=init.baseAsset;_setConfig(init.config);for(uint i;i<init.allowedAssets.length;i++) _add(init.allowedAssets[i]);if(!allowed[baseAsset]||!registry.isActive(baseAsset)) revert InactiveAsset(baseAsset);executor=init.executor;emit ExecutorUpdated(address(0),executor);}
 function transferOwnership(address next) external onlyOwner {if(next==address(0)) revert ZeroAddress();pendingOwner=next;} function acceptOwnership() external {if(msg.sender!=pendingOwner) revert Unauthorized();owner=msg.sender;pendingOwner=address(0);}
 function deposit(uint256 amount) external onlyOwner nonReentrant {if(amount==0) revert ZeroAmount();if(!assetRegistry.isActive(baseAsset)) revert InactiveAsset(baseAsset);_transferFrom(baseAsset,msg.sender,address(this),amount);emit Deposited(owner,baseAsset,amount);}
 function withdraw(address asset,uint256 amount) external onlyOwner nonReentrant {if(amount==0) revert ZeroAmount();_transfer(asset,owner,amount);emit Withdrawn(owner,asset,amount);}
 function addAllowedAsset(address asset) external onlyOwner {_add(asset);} function removeAllowedAsset(address asset) external onlyOwner {if(asset==baseAsset) revert BaseAssetRemovalForbidden();if(!allowed[asset]) revert AssetNotAllowed(asset);uint b=IERC20(asset).balanceOf(address(this));if(b!=0) revert AssetBalanceNotZero(asset,b);uint i=index[asset]-1;address last=assets[assets.length-1];assets[i]=last;index[last]=i+1;assets.pop();delete index[asset];delete allowed[asset];emit AllowedAssetRemoved(asset);}
 function allowedAssets() external view returns(address[] memory){return assets;} function isAssetAllowed(address a) external view returns(bool){return allowed[a];}
 function updateConfig(VaultConfig calldata c) external onlyOwner {_setConfig(c);} function setExecutor(address e) external onlyOwner {address old=executor;executor=e;emit ExecutorUpdated(old,e);} function pauseAutomation() external onlyOwner {automationPaused=true;emit AutomationPaused(owner);} function unpauseAutomation() external onlyOwner {automationPaused=false;emit AutomationUnpaused(owner);}
 function rebalance(Allocation[] calldata targets,Trade[] calldata trades) external onlyExecutor nonReentrant {if(automationPaused) revert VaultPaused();if(trades.length==0) revert EmptyRebalance();uint64 next=lastRebalance+config.minRebalanceInterval;if(block.timestamp<next) revert RebalanceTooSoon(next);_validateTargets(targets);for(uint i;i<trades.length;i++) _trade(trades[i]);_validateConcentration();lastRebalance=uint64(block.timestamp);emit Rebalanced(msg.sender,keccak256(abi.encode(targets)),trades.length,lastRebalance);}
 function _trade(Trade calldata t) private {if(t.tokenIn==address(0)||t.tokenOut==address(0)||t.tokenIn==t.tokenOut||t.amountIn==0||t.minAmountOut==0) revert InvalidTrade();if(!allowed[t.tokenIn]) revert AssetNotAllowed(t.tokenIn);if(!allowed[t.tokenOut]||!assetRegistry.isActive(t.tokenOut)) revert InactiveAsset(t.tokenOut);if(!assetRegistry.isRegistered(t.tokenIn)) revert UnsupportedAsset(t.tokenIn);uint floor=_oracleFloor(t.tokenIn,t.tokenOut,t.amountIn);if(t.minAmountOut<floor) revert OracleSlippageExceeded(t.minAmountOut,floor);uint beforeBal=IERC20(t.tokenOut).balanceOf(address(this));_approve(t.tokenIn,address(swapAdapter),0);_approve(t.tokenIn,address(swapAdapter),t.amountIn);swapAdapter.swap(t.tokenIn,t.tokenOut,t.amountIn,t.minAmountOut,t.routeData);_approve(t.tokenIn,address(swapAdapter),0);uint received=IERC20(t.tokenOut).balanceOf(address(this))-beforeBal;if(received<t.minAmountOut) revert InsufficientOutput(received,t.minAmountOut);emit TradeExecuted(t.tokenIn,t.tokenOut,t.amountIn,received);}
 function _validateTargets(Allocation[] calldata ts) private view {if(ts.length==0) revert InvalidAllocation();uint sum;for(uint i;i<ts.length;i++){if(!allowed[ts[i].asset]||!assetRegistry.isActive(ts[i].asset)) revert InactiveAsset(ts[i].asset);if(ts[i].targetBps>config.maxAllocationPerAssetBps) revert AllocationTooHigh(ts[i].asset,ts[i].targetBps,config.maxAllocationPerAssetBps);for(uint j;j<i;j++)if(ts[i].asset==ts[j].asset) revert InvalidAllocation();sum+=ts[i].targetBps;}if(sum!=BPS) revert InvalidAllocation();}
 function _validateConcentration() private view {uint total;uint[] memory values=new uint[](assets.length);for(uint i;i<assets.length;i++){uint b=IERC20(assets[i]).balanceOf(address(this));if(b>0){values[i]=_usd(assets[i],b);total+=values[i];}}if(total==0)return;for(uint i;i<assets.length;i++)if(values[i]*BPS/total>config.maxAllocationPerAssetBps) revert AllocationTooHigh(assets[i],values[i]*BPS/total,config.maxAllocationPerAssetBps);}
 function _oracleFloor(address a,address b,uint amount) private view returns(uint){AssetRegistry.AssetConfig memory x=assetRegistry.getAsset(a);AssetRegistry.AssetConfig memory y=assetRegistry.getAsset(b);uint px=_price(a,x);uint py=_price(b,y);uint expected=amount*px*(10**y.tokenDecimals)*(10**y.priceFeedDecimals)/(10**x.tokenDecimals)/(10**x.priceFeedDecimals)/py;return expected*(BPS-config.maxSlippageBps)/BPS;}
 function _usd(address a,uint amount) private view returns(uint){AssetRegistry.AssetConfig memory x=assetRegistry.getAsset(a);return amount*_price(a,x)/(10**x.tokenDecimals);}
 function _price(address a,AssetRegistry.AssetConfig memory x) private view returns(uint){if(!x.exists||x.priceFeed==address(0)) revert OracleUnavailable(a);(,int p,,uint updated,)=IAggregatorV3(x.priceFeed).latestRoundData();if(p<=0||updated==0||updated>block.timestamp||block.timestamp-updated>x.maxPriceAge) revert OracleUnavailable(a);return uint(p);}
 function _add(address a) private {if(!assetRegistry.isActive(a)) revert InactiveAsset(a);if(allowed[a]) revert AssetAlreadyAllowed(a);if(assets.length==MAX_ALLOWED_ASSETS) revert TooManyAllowedAssets();allowed[a]=true;assets.push(a);index[a]=assets.length;emit AllowedAssetAdded(a);} function _setConfig(VaultConfig calldata c) private {if(c.maxAllocationPerAssetBps==0||c.maxAllocationPerAssetBps>BPS||c.maxSlippageBps>MAX_SLIPPAGE_BPS||c.minRebalanceInterval>365 days) revert InvalidConfig();config=c;emit ConfigUpdated(c.maxAllocationPerAssetBps,c.maxSlippageBps,c.minRebalanceInterval);} function _transfer(address t,address to,uint a) private {if(!IERC20(t).transfer(to,a)) revert TransferFailed();} function _transferFrom(address t,address f,address to,uint a) private {if(!IERC20(t).transferFrom(f,to,a)) revert TransferFailed();} function _approve(address t,address s,uint a) private {if(!IERC20(t).approve(s,a)) revert TransferFailed();}
}
