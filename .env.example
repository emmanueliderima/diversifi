# Select one environment; values are intentionally not hardcoded.
NETWORK=local
LOCAL_RPC_URL=http://127.0.0.1:8545
X_LAYER_RPC_URL=
X_LAYER_TESTNET_RPC_URL=
PRIVATE_KEY=

# Development-only AI provider. Use a currently available free OpenRouter model slug.
# Never expose this key to the browser or give this process wallet/private-key access.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Diversifi Local
OPENROUTER_TIMEOUT_MS=20000

# Add deployed addresses only after deployment. Never use mock addresses outside local development.
VAULT_FACTORY_ADDRESS=
ASSET_REGISTRY_ADDRESS=
